<Window x:Class="SteamNativeBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam 原生浏览器"
        Width="1040" Height="840"
        MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        FontSize="13"
        Icon="Assets/app.ico"
        TextOptions.TextFormattingMode="Ideal"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootSurface" Background="#D9F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/app.ico" Width="16" Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Steam 原生浏览器"
                           Margin="10,0,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE921;" ToolTip="最小化" Click="Minimize_Click" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE922;" ToolTip="最大化" Click="Maximize_Click" />
                <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                        Content="&#xE8BB;" ToolTip="关闭" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Rectangle x:Name="BusyLine"
                   Grid.Row="0"
                   Height="2"
                   VerticalAlignment="Bottom"
                   Fill="{StaticResource AccentBrush}"
                   Visibility="Collapsed">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.25" To="1" Duration="0:0:0.9"
                                                         AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <!-- ================= 主体 ================= -->
        <ScrollViewer x:Name="PageScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      RequestBringIntoView="PageScroll_RequestBringIntoView">
            <StackPanel MaxWidth="880" Margin="34,6,34,30" HorizontalAlignment="Stretch">

                <TextBlock Style="{StaticResource H1}" Text="从 Steam 里唤醒真正的浏览器" />
                <TextBlock Style="{StaticResource Body}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="自动定位 Steam、开启 CEF 调试端口，并在 Steam 进程内弹出一个带地址栏和多标签页的原生 Chromium 窗口。" />

                <!-- 低权限环境提示 -->
                <Border x:Name="EnvBanner"
                        Visibility="Collapsed"
                        Margin="0,16,0,0"
                        Background="#FFF7DC"
                        BorderBrush="#EFDFA8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#8A5A00"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Margin="10,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="当前权限不足，启动 Steam 需要管理员授权"
                                       FontSize="12.5" FontWeight="SemiBold" Foreground="#6B4600" />
                            <TextBlock x:Name="EnvBannerText"
                                       FontSize="12"
                                       Foreground="#6B4600"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       Text="自动启动 Steam 时会请求管理员权限（UAC）。" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CopyPathButton"
                                    Content="复制路径"
                                    Style="{StaticResource SubtleButton}"
                                    Height="30" Margin="0,0,6,0"
                                    Click="CopyPath_Click" />
                            <Button x:Name="ElevateButton"
                                    Content="以管理员身份重启"
                                    Style="{StaticResource DefaultButton}"
                                    Height="30"
                                    Click="Elevate_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 状态 ============ -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Label}" Text="Steam 进程" />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Ellipse x:Name="SteamDot" Width="8" Height="8"
                                             Fill="{StaticResource GrayDotBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SteamStateText" Text="检测中…"
                                               Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Label}" Text="CEF 调试端口" />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Ellipse x:Name="CefDot" Width="8" Height="8"
                                             Fill="{StaticResource GrayDotBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CefStateText" Text="检测中…"
                                               Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="可用扩展后台" />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Ellipse x:Name="ExtDot" Width="8" Height="8"
                                             Fill="{StaticResource GrayDotBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ExtStateText" Text="检测中…"
                                               Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Rectangle Grid.Row="1" Height="1" Margin="0,14,0,12"
                                   Fill="{StaticResource DividerBrush}" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource Label}"
                                       Text="安装位置" VerticalAlignment="Center" />
                            <TextBlock x:Name="PathText" Grid.Column="1"
                                       Text="未检测到 Steam"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12.5" />
                            <Button x:Name="BrowseButton" Grid.Column="2" Content="浏览…"
                                    Style="{StaticResource SubtleButton}" Height="26"
                                    Click="Browse_Click" />
                            <Button x:Name="RefreshButton" Grid.Column="3" Content="重新检测"
                                    Style="{StaticResource SubtleButton}" Height="26"
                                    Margin="2,0,0,0" Click="Refresh_Click" />
                            <Button x:Name="OpenFolderButton" Grid.Column="4" Content="打开目录"
                                    Style="{StaticResource SubtleButton}" Height="26"
                                    Margin="2,0,0,0" Click="OpenFolder_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ 操作 ============ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="调出方式" />

                        <Border Margin="0,12,0,0"
                                Background="#F0F0F0"
                                CornerRadius="7"
                                Padding="3"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeBuiltIn" Style="{StaticResource SegmentButton}"
                                             GroupName="LaunchMode" IsChecked="True"
                                             Content="内置方式 · 推荐" />
                                <RadioButton x:Name="ModeExtension" Style="{StaticResource SegmentButton}"
                                             GroupName="LaunchMode" Margin="4,0,0,0"
                                             Content="插件方式" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0" FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Text="内置方式不需要任何插件；插件方式会调用已安装扩展的后台 Service Worker（chrome.windows.create）。" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Label}"
                                       Text="打开地址" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox x:Name="UrlBox" Grid.Column="1"
                                     Style="{StaticResource FluentTextBox}"
                                     Text="https://cn.bing.com/" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox x:Name="MaximizeToggle" Style="{StaticResource ToggleSwitch}"
                                      Content="最大化窗口" IsChecked="True" />
                            <CheckBox x:Name="AutoRestartToggle" Style="{StaticResource ToggleSwitch}"
                                      Content="需要时自动重启 Steam" IsChecked="True"
                                      Margin="28,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="LaunchButton" Style="{StaticResource AccentButton}"
                                    Height="40" Padding="20,0" Click="Launch_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Margin="0,0,9,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="一键调出浏览器窗口" FontSize="13.5" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DebugOnlyButton" Style="{StaticResource DefaultButton}"
                                    Content="仅开启调试模式" Height="40" Margin="10,0,0,0"
                                    Click="DebugOnly_Click" />
                            <Button x:Name="OpenPanelButton" Style="{StaticResource SubtleButton}"
                                    Content="打开调试面板" Height="40" Margin="6,0,0,0"
                                    Click="OpenPanel_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 日志 ============ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Style="{StaticResource H2}" Text="运行日志" VerticalAlignment="Center" />
                            <Button Content="清空" Style="{StaticResource SubtleButton}" Height="24"
                                    Padding="10,0" HorizontalAlignment="Right" Click="ClearLog_Click" />
                        </Grid>

                        <Border Grid.Row="1" Margin="0,8,0,0"
                                Background="#FAFAFA"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4">
                            <TextBox x:Name="LogBox"
                                     Height="118"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="8,6"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11.5"
                                     Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Margin="2,14,0,0"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Text="提示：调出的窗口运行在 Steam 的 CEF 中，共享 Steam 的网页缓存与扩展，会随 Steam 退出而关闭；它与系统里安装的 Chrome 配置相互独立。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

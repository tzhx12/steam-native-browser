<Page x:Class="SteamNativeBrowser.WinUI.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" Padding="32,18,32,44" Spacing="16" HorizontalAlignment="Center">

            <!-- 应用标识 -->
            <StackPanel Orientation="Horizontal" Spacing="18" Margin="2,4,0,8">
                <Image Source="ms-appx:///Assets/app.png" Width="72" Height="72" />
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Steam 原生浏览器" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedBodyStyle}" />
                    <TextBlock Style="{StaticResource MutedCaptionStyle}"
                               Text="Steam Native Browser · WinUI 3 重构版" />
                </StackPanel>
            </StackPanel>

            <!-- 简介 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="它是什么" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource MutedBodyStyle}"
                               Text="从 Steam 自己的 CEF 进程内部调出一个完整的 Chromium 窗口：带地址栏、多标签页、扩展按钮，而不是 Steam 内置的简易浏览器。程序会自动定位 Steam、检查并开启 CEF 调试端口（127.0.0.1:8080），再通过 DevTools 协议创建窗口。" />

                    <StackPanel Spacing="8" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="内置方式：无需任何插件，直接使用 Target.createTarget" Style="{StaticResource MutedBodyStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="插件方式：调用扩展 Service Worker 的 chrome.windows.create，失败自动回退" Style="{StaticResource MutedBodyStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="低权限 / 注册表不可写时自动请求 UAC，只提权 Steam" Style="{StaticResource MutedBodyStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 许可证 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="开源许可证" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource MutedBodyStyle}"
                               Text="本项目使用 MIT License 发布：可以自由使用、修改、分发，保留版权声明即可。" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="MIT" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <Button Content="查看完整许可证" Click="ShowLicense_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- GitHub -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="GitHub 项目" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource MutedBodyStyle}"
                               Text="源代码、更新日志与问题反馈都在 GitHub 上：tzhx12/steam-native-browser。" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                        <HyperlinkButton Content="仓库主页"
                                         NavigateUri="https://github.com/tzhx12/steam-native-browser" />
                        <HyperlinkButton Content="Releases"
                                         NavigateUri="https://github.com/tzhx12/steam-native-browser/releases" />
                        <HyperlinkButton Content="问题反馈"
                                         NavigateUri="https://github.com/tzhx12/steam-native-browser/issues" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 链接 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="相关链接" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                    <HyperlinkButton Content="WinUI / Microsoft.UI.Xaml（GitHub）"
                                     NavigateUri="https://github.com/microsoft/microsoft-ui-xaml" />
                    <HyperlinkButton Content="Windows App SDK 文档"
                                     NavigateUri="https://learn.microsoft.com/windows/apps/windows-app-sdk/" />
                    <HyperlinkButton Content="Steam 官方站点" NavigateUri="https://store.steampowered.com/" />
                </StackPanel>
            </Border>

            <!-- 致谢 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="致谢" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource MutedBodyStyle}"
                               Text="界面基于 Microsoft WinUI 3 / Windows App SDK 构建（MIT）；窗口通信使用 Chrome DevTools Protocol；图标由项目自带脚本生成。" />
                    <TextBlock x:Name="SystemInfoText" Style="{StaticResource MutedCaptionStyle}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource MutedCaptionStyle}" Margin="2,2,0,0"
                       Text="仅供本机自用与学习研究。调出的窗口属于 Steam 的 CEF，会随 Steam 退出而关闭。" />
        </StackPanel>
    </ScrollViewer>
</Page>




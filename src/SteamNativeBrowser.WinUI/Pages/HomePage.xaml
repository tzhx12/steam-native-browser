<Page x:Class="SteamNativeBrowser.WinUI.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Padding="32,14,32,34" Spacing="12" HorizontalAlignment="Center">

            <!-- 标题 -->
            <StackPanel Spacing="6">
                <TextBlock Text="从 Steam 里唤醒真正的浏览器" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Style="{StaticResource MutedBodyStyle}"
                           Text="自动定位 Steam、开启 CEF 调试端口，并在 Steam 进程内弹出一个带地址栏和多标签页的原生 Chromium 窗口。" />
            </StackPanel>

            <!-- 低权限提示 -->
            <InfoBar x:Name="EnvInfoBar"
                     Severity="Warning"
                     IsOpen="False"
                     IsClosable="False"
                     Title="当前权限不足，启动 Steam 需要管理员授权">
                <InfoBar.Content>
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <TextBlock x:Name="EnvInfoText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <HyperlinkButton Content="复制程序路径" Click="CopyPath_Click" Padding="0" />
                    </StackPanel>
                </InfoBar.Content>
                <InfoBar.ActionButton>
                    <Button Content="以管理员身份重启" Click="Elevate_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- 状态 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16,14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F8;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Steam 进程" Style="{StaticResource MutedCaptionStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                            <Ellipse x:Name="SteamDot" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="SteamStateText" Text="检测中…" Style="{StaticResource StatusValueStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16,14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE774;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="CEF 调试端口" Style="{StaticResource MutedCaptionStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                            <Ellipse x:Name="CefDot" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="CefStateText" Text="检测中…" Style="{StaticResource StatusValueStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7B8;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="可用扩展后台" Style="{StaticResource MutedCaptionStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                            <Ellipse x:Name="ExtDot" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="ExtStateText" Text="检测中…" Style="{StaticResource StatusValueStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 安装位置 -->
            <Border Style="{StaticResource CardStyle}" Padding="16,8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="安装位置" Style="{StaticResource MutedCaptionStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="PathText" Grid.Column="1" Text="未检测到 Steam" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                    <Button x:Name="BrowseButton" Grid.Column="2" Content="浏览…" Click="Browse_Click" />
                    <Button x:Name="RefreshButton" Grid.Column="3" Content="重新检测" Click="Refresh_Click" />
                    <Button x:Name="OpenFolderButton" Grid.Column="4" Content="打开目录" Click="OpenFolder_Click" />
                </Grid>
            </Border>

            <!-- 操作 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="调出方式" Style="{StaticResource SectionTitleStyle}" />

                    <SelectorBar x:Name="ModeSelector" SelectionChanged="ModeSelector_SelectionChanged">
                        <SelectorBarItem Text="内置方式 · 推荐" Tag="builtin" IsSelected="True" />
                        <SelectorBarItem Text="插件方式" Tag="extension" />
                    </SelectorBar>

                    <TextBlock x:Name="ModeDescriptionText" Style="{StaticResource MutedCaptionStyle}"
                               Text="内置方式不需要任何插件，通过 DevTools 协议直接在 Steam 进程里创建窗口。" />

                    <TextBox x:Name="UrlBox" Header="打开地址" Text="https://cn.bing.com/"
                             PlaceholderText="https://example.com" />

                    <StackPanel Orientation="Horizontal" Spacing="36">
                        <ToggleSwitch x:Name="MaximizeToggle" Header="窗口大小"
                                      OnContent="最大化" OffContent="普通窗口" IsOn="True" />
                        <ToggleSwitch x:Name="AutoRestartToggle" Header="Steam 未开调试端口时"
                                      OnContent="自动重启 Steam" OffContent="仅提示" IsOn="True" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                        <Button x:Name="LaunchButton" Style="{StaticResource AccentButtonStyle}"
                                Height="40" Padding="20,0" Click="Launch_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE774;" FontSize="16" />
                                <TextBlock Text="一键调出浏览器窗口" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DebugOnlyButton" Content="仅开启调试模式" Height="40" Click="DebugOnly_Click" />
                        <Button x:Name="OpenPanelButton" Content="打开调试面板" Height="40" Click="OpenPanel_Click" />
                    </StackPanel>

                    <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Style="{StaticResource CardStyle}" Padding="20,14,20,18">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                            <HyperlinkButton Content="复制" Click="CopyLog_Click" />
                            <HyperlinkButton Content="清空" Click="ClearLog_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ScrollViewer x:Name="LogScroll" Height="150" Padding="12,8"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource LogTextStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource MutedCaptionStyle}" Margin="2,2,0,0"
                       Text="提示：调出的窗口运行在 Steam 的 CEF 中，共享 Steam 的网页缓存与扩展，会随 Steam 退出而关闭。" />
        </StackPanel>
    </ScrollViewer>
</Page>

